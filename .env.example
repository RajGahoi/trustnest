# TrustNest Environment Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=trustnest_super_secure_jwt_secret_key_2026_xyz!
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4000

# Database Persistence Engine:
# 1. Local / Edge SQLite (Default - zero external daemons, files stored in data/trustnest.db):
DATABASE_PATH=data/trustnest.db

# 2. Production PostgreSQL (Uncomment and set your connection string for Postgres deployments):
# DATABASE_URL=postgresql://user:password@localhost:5432/trustnest_db

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
